# GEMINI_API_KEY: Required for Gemini AI API calls (Vision, OCR, Embeddings, fallback)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional fast LLM & Whisper speech-to-text key (fallback to Gemini if not provided)
GROQ_API_KEY=""

# GROQ_MODEL: Default groq model
GROQ_MODEL="llama-3.3-70b-versatile"

# GROQ_STT_MODEL: Default groq speech-to-text model
GROQ_STT_MODEL="whisper-large-v3-turbo"

# GEMINI_MODEL: Default Gemini model
GEMINI_MODEL="gemini-2.5-flash"

# GEMINI_EMBEDDING_MODEL: Embedding model
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# JWT_SECRET: Secret for signing session tokens
JWT_SECRET="campussathi-super-secret-key-2026"

# PORT: Server port
PORT="3000"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

